{
  "title": "Pymes Admin",
  "uid": "pymes-admin",
  "tags": ["pymes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "UP",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [{ "expr": "up{job=\"pymes\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests /s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)", "refId": "A", "legendFormat": "{{application}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, application))", "refId": "A", "legendFormat": "{{application}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [{ "expr": "jvm_memory_used_bytes{area=\"heap\"}", "refId": "A", "legendFormat": "{{application}} {{id}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Hikari pending / active",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "hikaricp_connections_pending{pool=\"HikariPool-1\"}", "refId": "A", "legendFormat": "pending {{application}}" },
        { "expr": "hikaricp_connections_active{pool=\"HikariPool-1\"}", "refId": "B", "legendFormat": "active {{application}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errors 5xx /s",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (application)", "refId": "A", "legendFormat": "{{application}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 0.1 }] } } }
    }
  ]
}
