# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pymes_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ==================== REDIS ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== GOOGLE OAUTH2 ====================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==================== FACEBOOK OAUTH2 ====================
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# ==================== JWT ====================
# Generar con: openssl rand -base64 32
JWT_SECRET=change-this-secret-key-in-production-minimum-256-bits
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ==================== MAIL ====================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# ==================== SERVER & CORS ====================
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:9200
APP_FRONTEND_URL=http://localhost:9200

# ==================== SWAGGER / API DOC ====================
# Set to false to disable Swagger in production
SWAGGER_ENABLED=true
SWAGGER_SERVER_URL=http://localhost:8080
