<?xml version="1.0" encoding="UTF-8"?>
<!-- MonthlyReport: resumen mensual al OWNER, 2 paginas A4, tema claro.
     Pagina 1 = resultado del mes + ventas por semana + proveedores; pagina 2 =
     compras y cierre. Paleta parcial .ulpi/design/DESIGN.md: bronce #C8963E/#8B6B3A,
     exito #3D7A5A, peligro #A04038, grises calidos para texto. Sin charts (Jasper 7
     sin JFreeChart), sin ${} (filtering=true del pom), DejaVu embebida. -->
<!-- Jasper 7: la raiz NO debe tener namespace (JRXmlLoader lo rechaza si lo trae). -->
<jasperReport name="MonthlyReport" pageWidth="595" pageHeight="842"
              columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">

  <parameter name="logoStream" class="java.io.InputStream"/>
  <parameter name="tenantName" class="java.lang.String"/>
  <parameter name="periodoLabel" class="java.lang.String"/>
  <parameter name="moneda" class="java.lang.String"/>
  <parameter name="ingresos" class="java.math.BigDecimal"/>
  <parameter name="costoCompras" class="java.math.BigDecimal"/>
  <parameter name="gastosOperativos" class="java.math.BigDecimal"/>
  <parameter name="neto" class="java.math.BigDecimal"/>
  <parameter name="diasCargados" class="java.lang.Integer"/>
  <parameter name="diasDelMes" class="java.lang.Integer"/>
  <parameter name="sinVentas" class="java.lang.Boolean"/>
  <parameter name="semanasDs" class="net.sf.jasperreports.engine.JRDataSource"/>
  <parameter name="proveedoresDs" class="net.sf.jasperreports.engine.JRDataSource"/>
  <parameter name="productosDs" class="net.sf.jasperreports.engine.JRDataSource"/>
  <parameter name="gastosDs" class="net.sf.jasperreports.engine.JRDataSource"/>
  <parameter name="egresosPorMetodoDs" class="net.sf.jasperreports.engine.JRDataSource"/>
  <parameter name="tieneEgresosPorMetodo" class="java.lang.Boolean"/>
  <parameter name="egresosTotal" class="java.math.BigDecimal"/>
  <parameter name="ingresosPorMetodoDs" class="net.sf.jasperreports.engine.JRDataSource"/>
  <parameter name="tieneIngresosPorMetodo" class="java.lang.Boolean"/>
  <parameter name="ingresosTotal" class="java.math.BigDecimal"/>
  <parameter name="tieneProductos" class="java.lang.Boolean"/>
  <parameter name="tieneGastos" class="java.lang.Boolean"/>
  <parameter name="tieneProveedores" class="java.lang.Boolean"/>
  <parameter name="retornoLinea1" class="java.lang.String"/>
  <parameter name="retornoLinea2" class="java.lang.String"/>

  <dataset name="SemanasDS">
    <parameter name="moneda" class="java.lang.String"/>
    <field name="rango" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
  </dataset>

  <dataset name="ProveedoresDS">
    <parameter name="moneda" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
    <field name="facturas" class="java.lang.Long"/>
  </dataset>

  <dataset name="ProductosDS">
    <parameter name="moneda" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="cantidad" class="java.math.BigDecimal"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
  </dataset>

  <dataset name="GastosDS">
    <parameter name="moneda" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
    <field name="facturas" class="java.lang.Long"/>
  </dataset>

  <dataset name="EgresosPorMetodoDS">
    <parameter name="moneda" class="java.lang.String"/>
    <field name="metodo" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
  </dataset>

  <dataset name="IngresosPorMetodoDS">
    <parameter name="moneda" class="java.lang.String"/>
    <field name="metodo" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
  </dataset>

  <style name="NetoNumber" fontName="DejaVu Sans" fontSize="26" bold="true" forecolor="#3D7A5A">
    <conditionalStyle>
      <conditionExpression><![CDATA[$P{neto}.signum() < 0]]></conditionExpression>
      <style forecolor="#A04038"/>
    </conditionalStyle>
  </style>
  <style name="TableHeader" fontName="DejaVu Sans" fontSize="9" bold="true" forecolor="#8B6B3A" backcolor="#F3F0E7"/>
  <style name="TableCell" fontName="DejaVu Sans" fontSize="10" forecolor="#2E3138"/>

  <title height="680">
    <element kind="image" x="0" y="0" width="44" height="44">
      <expression class="java.io.InputStream"><![CDATA[$P{logoStream}]]></expression>
    </element>
    <element kind="staticText" x="54" y="0" width="200" height="22" forecolor="#8B6B3A" fontName="DejaVu Sans" fontSize="15" bold="true">
      <text><![CDATA[PYMEQ]]></text>
    </element>
    <element kind="textField" x="54" y="22" width="360" height="18" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="12" bold="true" blankWhenNull="true">
      <expression><![CDATA[$P{tenantName}]]></expression>
    </element>
    <element kind="textField" x="315" y="4" width="200" height="16" forecolor="#6B6863" hTextAlign="Right" fontName="DejaVu Sans" fontSize="10" blankWhenNull="true">
      <expression><![CDATA[$P{periodoLabel}]]></expression>
    </element>
    <element kind="line" x="0" y="56" width="515" height="1" forecolor="#C8963E"/>

    <element kind="staticText" x="0" y="70" width="515" height="16" forecolor="#6B6863" fontName="DejaVu Sans" fontSize="11">
      <text><![CDATA[Vendiste]]></text>
    </element>
    <element kind="textField" x="0" y="86" width="515" height="36" forecolor="#8B6B3A" fontName="DejaVu Sans" fontSize="26" bold="true">
      <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($P{ingresos})]]></expression>
    </element>
    <element kind="staticText" x="0" y="128" width="515" height="16" forecolor="#6B6863" fontName="DejaVu Sans" fontSize="11">
      <text><![CDATA[Te quedaron]]></text>
    </element>
    <element kind="textField" x="0" y="144" width="515" height="36" style="NetoNumber">
      <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($P{neto})]]></expression>
    </element>

    <element kind="rectangle" x="0" y="196" width="162" height="76" backcolor="#FFFFFF" forecolor="#E4E1D6"/>
    <element kind="staticText" x="12" y="204" width="138" height="14" forecolor="#6B6863" fontName="DejaVu Sans" fontSize="9" bold="true">
      <text><![CDATA[COMPRAS]]></text>
    </element>
    <element kind="textField" x="12" y="222" width="138" height="24" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="14" bold="true">
      <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($P{costoCompras})]]></expression>
    </element>

    <element kind="rectangle" x="177" y="196" width="162" height="76" backcolor="#FFFFFF" forecolor="#E4E1D6"/>
    <element kind="staticText" x="189" y="204" width="138" height="14" forecolor="#6B6863" fontName="DejaVu Sans" fontSize="9" bold="true">
      <text><![CDATA[GASTOS]]></text>
    </element>
    <element kind="textField" x="189" y="222" width="138" height="24" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="14" bold="true">
      <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($P{gastosOperativos})]]></expression>
    </element>

    <element kind="rectangle" x="353" y="196" width="162" height="76" backcolor="#FFFFFF" forecolor="#E4E1D6"/>
    <element kind="staticText" x="365" y="204" width="138" height="14" forecolor="#6B6863" fontName="DejaVu Sans" fontSize="9" bold="true">
      <text><![CDATA[DÍAS CARGADOS]]></text>
    </element>
    <element kind="textField" x="365" y="222" width="138" height="24" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="14" bold="true">
      <expression><![CDATA[$P{diasCargados} + " de " + $P{diasDelMes}]]></expression>
    </element>

    <element kind="textField" x="0" y="282" width="515" height="20" forecolor="#8B6B3A" fontName="DejaVu Sans" fontSize="11" bold="true">
      <expression><![CDATA[$P{sinVentas} ? "Sin ventas registradas en el periodo." : ""]]></expression>
    </element>

    <element kind="staticText" x="0" y="322" width="515" height="22" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="13" bold="true" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[!$P{sinVentas}]]></printWhenExpression>
      <text><![CDATA[Ventas por semana]]></text>
    </element>
    <element kind="component" x="0" y="350" width="515" height="104" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[!$P{sinVentas}]]></printWhenExpression>
      <component kind="table" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components">
        <datasetRun subDataset="SemanasDS">
          <parameter name="moneda">
            <expression><![CDATA[$P{moneda}]]></expression>
          </parameter>
          <dataSourceExpression><![CDATA[$P{semanasDs}]]></dataSourceExpression>
        </datasetRun>
        <column kind="single" width="200">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="8" y="0" width="192" height="24">
              <text><![CDATA[SEMANA]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="8" y="0" width="192" height="20" blankWhenNull="true">
              <expression><![CDATA[$F{rango}]]></expression>
            </element>
          </detailCell>
        </column>
        <column kind="single" width="315">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="0" y="0" width="307" height="24" hTextAlign="Right">
              <text><![CDATA[TOTAL]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="0" y="0" width="307" height="20" hTextAlign="Right">
              <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($F{total})]]></expression>
            </element>
          </detailCell>
        </column>
      </component>
    </element>

    <element kind="staticText" x="0" y="474" width="515" height="22" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="13" bold="true" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneProveedores}]]></printWhenExpression>
      <text><![CDATA[Principales proveedores]]></text>
    </element>
    <element kind="component" x="0" y="502" width="515" height="124" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneProveedores}]]></printWhenExpression>
      <component kind="table" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components">
        <datasetRun subDataset="ProveedoresDS">
          <parameter name="moneda">
            <expression><![CDATA[$P{moneda}]]></expression>
          </parameter>
          <dataSourceExpression><![CDATA[$P{proveedoresDs}]]></dataSourceExpression>
        </datasetRun>
        <column kind="single" width="275">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="8" y="0" width="267" height="24">
              <text><![CDATA[PROVEEDOR]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="8" y="0" width="267" height="20" blankWhenNull="true">
              <expression><![CDATA[$F{nombre}]]></expression>
            </element>
          </detailCell>
        </column>
        <column kind="single" width="80">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="0" y="0" width="72" height="24" hTextAlign="Right">
              <text><![CDATA[FACTURAS]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="0" y="0" width="72" height="20" pattern="#,##0" hTextAlign="Right">
              <expression><![CDATA[$F{facturas}]]></expression>
            </element>
          </detailCell>
        </column>
        <column kind="single" width="160">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="0" y="0" width="152" height="24" hTextAlign="Right">
              <text><![CDATA[TOTAL]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="0" y="0" width="152" height="20" hTextAlign="Right">
              <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($F{total})]]></expression>
            </element>
          </detailCell>
        </column>
      </component>
    </element>

    <element kind="textField" x="0" y="640" width="515" height="30" forecolor="#6B6863" fontName="DejaVu Sans" fontSize="9">
      <expression><![CDATA["Neto de " + $P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($P{neto}) + " en " + $P{diasCargados} + " días cargados de " + $P{diasDelMes} + "."]]></expression>
    </element>
  </title>

  <summary height="760" splitType="Stretch">
    <element kind="staticText" x="0" y="0" width="515" height="22" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="13" bold="true">
      <printWhenExpression><![CDATA[$P{tieneProductos}]]></printWhenExpression>
      <text><![CDATA[Lo que más compraste]]></text>
    </element>
    <element kind="component" x="0" y="28" width="515" height="130">
      <printWhenExpression><![CDATA[$P{tieneProductos}]]></printWhenExpression>
      <component kind="table" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components">
        <datasetRun subDataset="ProductosDS">
          <parameter name="moneda">
            <expression><![CDATA[$P{moneda}]]></expression>
          </parameter>
          <dataSourceExpression><![CDATA[$P{productosDs}]]></dataSourceExpression>
        </datasetRun>
        <column kind="single" width="245">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="8" y="0" width="237" height="24">
              <text><![CDATA[PRODUCTO]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="8" y="0" width="237" height="20" blankWhenNull="true">
              <expression><![CDATA[$F{nombre}]]></expression>
            </element>
          </detailCell>
        </column>
        <column kind="single" width="130">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="0" y="0" width="122" height="24" hTextAlign="Right">
              <text><![CDATA[CANTIDAD]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="0" y="0" width="122" height="20" hTextAlign="Right">
              <expression><![CDATA[new java.text.DecimalFormat("#,##0.##").format($F{cantidad}) + " " + $F{unidad}]]></expression>
            </element>
          </detailCell>
        </column>
        <column kind="single" width="140">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="0" y="0" width="132" height="24" hTextAlign="Right">
              <text><![CDATA[TOTAL]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="0" y="0" width="132" height="20" hTextAlign="Right">
              <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($F{total})]]></expression>
            </element>
          </detailCell>
        </column>
      </component>
    </element>

    <element kind="staticText" x="0" y="210" width="515" height="22" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="13" bold="true">
      <printWhenExpression><![CDATA[$P{tieneGastos}]]></printWhenExpression>
      <text><![CDATA[Tus gastos más grandes]]></text>
    </element>
    <element kind="component" x="0" y="238" width="515" height="90">
      <printWhenExpression><![CDATA[$P{tieneGastos}]]></printWhenExpression>
      <component kind="table" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components">
        <datasetRun subDataset="GastosDS">
          <parameter name="moneda">
            <expression><![CDATA[$P{moneda}]]></expression>
          </parameter>
          <dataSourceExpression><![CDATA[$P{gastosDs}]]></dataSourceExpression>
        </datasetRun>
        <column kind="single" width="275">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="8" y="0" width="267" height="24">
              <text><![CDATA[GASTO]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="8" y="0" width="267" height="20" blankWhenNull="true">
              <expression><![CDATA[$F{nombre}]]></expression>
            </element>
          </detailCell>
        </column>
        <column kind="single" width="80">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="0" y="0" width="72" height="24" hTextAlign="Right">
              <text><![CDATA[FACTURAS]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="0" y="0" width="72" height="20" pattern="#,##0" hTextAlign="Right">
              <expression><![CDATA[$F{facturas}]]></expression>
            </element>
          </detailCell>
        </column>
        <column kind="single" width="160">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="0" y="0" width="152" height="24" hTextAlign="Right">
              <text><![CDATA[TOTAL]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="0" y="0" width="152" height="20" hTextAlign="Right">
              <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($F{total})]]></expression>
            </element>
          </detailCell>
        </column>
      </component>
    </element>

    <element kind="staticText" x="0" y="336" width="515" height="22" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="13" bold="true" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneIngresosPorMetodo}]]></printWhenExpression>
      <text><![CDATA[Recibiste este mes]]></text>
    </element>
    <element kind="component" x="0" y="364" width="515" height="80" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneIngresosPorMetodo}]]></printWhenExpression>
      <component kind="table" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components">
        <datasetRun subDataset="IngresosPorMetodoDS">
          <parameter name="moneda">
            <expression><![CDATA[$P{moneda}]]></expression>
          </parameter>
          <dataSourceExpression><![CDATA[$P{ingresosPorMetodoDs}]]></dataSourceExpression>
        </datasetRun>
        <column kind="single" width="355">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="8" y="0" width="347" height="24">
              <text><![CDATA[MÉTODO]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="8" y="0" width="347" height="20" blankWhenNull="true">
              <expression><![CDATA[$F{metodo}]]></expression>
            </element>
          </detailCell>
        </column>
        <column kind="single" width="160">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="0" y="0" width="152" height="24" hTextAlign="Right">
              <text><![CDATA[TOTAL]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="0" y="0" width="152" height="20" hTextAlign="Right">
              <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($F{total})]]></expression>
            </element>
          </detailCell>
        </column>
      </component>
    </element>
    <element kind="textField" x="0" y="444" width="515" height="18" forecolor="#8B6B3A" fontName="DejaVu Sans" fontSize="12" bold="true" hTextAlign="Right" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneIngresosPorMetodo}]]></printWhenExpression>
      <expression><![CDATA["Total recibido: " + $P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($P{ingresosTotal})]]></expression>
    </element>
    <element kind="staticText" x="0" y="462" width="515" height="14" forecolor="#9B9790" fontName="DejaVu Sans" fontSize="9" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneIngresosPorMetodo}]]></printWhenExpression>
      <text><![CDATA[Incluye ventas sin desglose por método.]]></text>
    </element>

    <element kind="staticText" x="0" y="480" width="515" height="22" forecolor="#1E2129" fontName="DejaVu Sans" fontSize="13" bold="true" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneEgresosPorMetodo}]]></printWhenExpression>
      <text><![CDATA[Pagaste este mes]]></text>
    </element>
    <element kind="component" x="0" y="508" width="515" height="80" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneEgresosPorMetodo}]]></printWhenExpression>
      <component kind="table" xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components">
        <datasetRun subDataset="EgresosPorMetodoDS">
          <parameter name="moneda">
            <expression><![CDATA[$P{moneda}]]></expression>
          </parameter>
          <dataSourceExpression><![CDATA[$P{egresosPorMetodoDs}]]></dataSourceExpression>
        </datasetRun>
        <column kind="single" width="355">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="8" y="0" width="347" height="24">
              <text><![CDATA[MÉTODO]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="8" y="0" width="347" height="20" blankWhenNull="true">
              <expression><![CDATA[$F{metodo}]]></expression>
            </element>
          </detailCell>
        </column>
        <column kind="single" width="160">
          <columnHeader style="TableHeader" height="24">
            <element kind="staticText" x="0" y="0" width="152" height="24" hTextAlign="Right">
              <text><![CDATA[TOTAL]]></text>
            </element>
          </columnHeader>
          <detailCell style="TableCell" height="20">
            <element kind="textField" x="0" y="0" width="152" height="20" hTextAlign="Right">
              <expression><![CDATA[$P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($F{total})]]></expression>
            </element>
          </detailCell>
        </column>
      </component>
    </element>

    <element kind="textField" x="0" y="596" width="515" height="18" forecolor="#8B6B3A" fontName="DejaVu Sans" fontSize="12" bold="true" hTextAlign="Right" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneEgresosPorMetodo}]]></printWhenExpression>
      <expression><![CDATA["Total pagado: " + $P{moneda} + " " + new java.text.DecimalFormat("#,##0.00").format($P{egresosTotal})]]></expression>
    </element>
    <element kind="staticText" x="0" y="614" width="515" height="14" forecolor="#9B9790" fontName="DejaVu Sans" fontSize="9" removeLineWhenBlank="true">
      <printWhenExpression><![CDATA[$P{tieneEgresosPorMetodo}]]></printWhenExpression>
      <text><![CDATA[Solo facturas pagadas del mes.]]></text>
